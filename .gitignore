# =========================
# Vivado / Vitis build junk
# =========================
# Keep: rtl/ constraints/ tcl/ sim/ scripts/ sw/ docs/ skill/ output/bit+xsa
# Drop: project caches, run logs, simulator work dirs

vivado_system/
vivado_sim/
vivado_proj/
.Xil/
*.xpr
*.jou
*.log
*.str
*.pb
*.wdb
*.wcfg
*.dcp
*.ltx
*.cache/
*.runs/
*.hw/
*.ip_user_files/
*.gen/
*.sim/
*.srcs/
*.nstr
*.debug
*.diags
hs_err_pid*.log
vivado*.zip

# Vitis workspaces (keep source under sw/, not full workspace)
vitis/
vitis_udp/
vitis_prj/
*.elf
*.o
*.a
*.bif
*.mss
*.hdf
.sdk/
.XSCT/
*.xsa.bak

# Simulation artifacts
vivado_sim/
*.vcd
*.vvp
xsim.dir/
xvlog*
xelab*
xsim*
webtalk*
*.jou

# =========================
# Outputs worth keeping
# =========================
# Keep system.bit / system.xsa / reports for reproducibility
!output/system.bit
!output/system.xsa
output/*.dcp
output/*.ltx
output/*.png

# =========================
# Python host
# =========================
__pycache__/
*.pyc
.venv/
*.egg-info/

